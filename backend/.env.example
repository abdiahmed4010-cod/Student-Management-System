# ==============================================================================
# STUDENTLY Django Backend — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development and replace placeholder values.
# NEVER commit `.env` or real production secrets to source control.
# ==============================================================================

# Environment mode: "development" or "production"
DJANGO_ENV=development

# Debug mode (must be False in production)
DJANGO_DEBUG=True

# Cryptographic signing key — replace with a unique random 50+ char string
# Generate one locally with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-key

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Localization
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC

# Database engine selector: "sqlite" (Stage 3.2 development)
# "mysql" is reserved for a later production configuration stage.
DB_ENGINE=sqlite

# Development SQLite database filename or path (relative to backend/ unless absolute)
SQLITE_DB_NAME=db.sqlite3

# Production-only HTTPS/HSTS overrides (used when DJANGO_ENV=production / DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# JWT Authentication (SimpleJWT — Phase 1/2 Security Requirements)
# Access token: 15-30 minutes; Refresh token: 7-14 days
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256

# Authentication endpoint throttling (per IP / client)
THROTTLE_AUTH_TOKEN=5/min
THROTTLE_AUTH_TOKEN_REFRESH=30/min
THROTTLE_AUTH_TOKEN_VERIFY=60/min
